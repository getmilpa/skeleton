{
  "name": "milpa/skeleton",
  "description": "RETIRED \u2014 use milpa/framework. The former composer create-project starting point for a Milpa app.",
  "keywords": [
    "php",
    "milpa",
    "framework",
    "skeleton",
    "create-project",
    "starter",
    "boilerplate"
  ],
  "type": "project",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "php": ">=8.3",
    "milpa/auth": "^0.3",
    "milpa/command": "^0.3",
    "milpa/console": "^0.4",
    "milpa/container": "^0.1",
    "milpa/core": "^0.6.2 || ^0.7 || ^0.8",
    "milpa/data": "^0.2",
    "milpa/devtools": "^0.9",
    "milpa/events": "^0.2",
    "milpa/http": "^0.1",
    "milpa/plugin": "^0.5",
    "milpa/runtime": "^0.7",
    "milpa/tool-runtime": "^0.9",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65"
  },
  "suggest": {
    "milpa/mcp-server": "Install to expose this app's tools over MCP \u2014 the agent-ready surface (tool-runtime already ships, since the CLI's consent gate is built on it). Or: `php bin/coa agent:enable`."
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Milpa\\Plugins\\": "plugins/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/coa"
  ],
  "config": {
    "sort-packages": true
  },
  "abandoned": "milpa/framework"
}
